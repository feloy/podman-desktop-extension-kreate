{
  "name": "kreate",
  "displayName": "Kreate",
  "description": "Provide templates and documentation to create Kubernetes resources",
  "version": "0.5.0-next",
  "icon": "icon.png",
  "publisher": "podman-desktop",
  "license": "Apache-2.0",
  "engines": {
    "podman-desktop": ">=1.16.0"
  },
  "main": "./dist/extension.js",
  "scripts": {
    "build": "vite build",
    "test": "vitest run --coverage",
    "test:watch": "vitest watch --coverage",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "format:fix": "prettier --write \"src/**/*.ts\"",
    "lint:check": "eslint .",
    "lint:fix": "eslint . --fix",
    "watch": "vite --mode development build -w"
  },
  "devDependencies": {
    "@podman-desktop/api": "1.30.5",
    "@types/node": "^24",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitest/coverage-v8": "^5",
    "eslint": "^10.13.0",
    "eslint-import-resolver-custom-alias": "^1.3.2",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-no-null": "^1.0.2",
    "eslint-plugin-sonarjs": "^4.2.2",
    "prettier": "^3.9.10",
    "typescript": "5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5"
  },
  "dependencies": {
    "@kubernetes/client-node": "2.0.1",
    "@scalar/openapi-parser": "^0.29.16",
    "undici": "^8.12.3",
    "js-yaml": "^5.2.0",
    "semver": "^7.8.5",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  }
}
